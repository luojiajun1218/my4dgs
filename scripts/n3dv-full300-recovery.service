[Unit]
Description=Complete and verify the five remaining N3DV 300-frame sequences
After=network-online.target display-manager.service
Wants=network-online.target
ConditionPathExists=!/home/gamer-02/Documents/DeepLearning/my4dgs/output/n3dv_other5_full300_20261019/batch_complete

[Service]
Type=simple
User=gamer-02
Group=gamer-02
WorkingDirectory=/home/gamer-02/Documents/DeepLearning/my4dgs
ExecStartPre=+/bin/bash -c 'for attempt in {1..30}; do /usr/bin/nvidia-smi --power-limit=350 && exit 0; sleep 2; done; exit 1'
ExecStart=/bin/bash -lc 'source /home/gamer-02/Documents/Codex/miniforge3/etc/profile.d/conda.sh; conda activate ReConGS; exec python -u scripts/resume_n3dv_after_reboot.py'
ExecStopPost=+/usr/bin/nvidia-smi --power-limit=480
Restart=no
TimeoutStopSec=30
